{
  "name": "animations-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @animations/apple-animation dev",
    "build": "pnpm catalog && pnpm -r --if-present build && node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "lint": "oxlint --deny-warnings . && node scripts/check-boundaries.mjs && node scripts/catalog.mjs --check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "catalog": "node scripts/catalog.mjs",
    "playground": "pnpm build && node scripts/serve-demos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.14.0"
}
